{
  "name": "@blendsdk/upload-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Resumable file upload system for BlendSDK v5, React 19 and Fluent UI v9",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=12.8.0 <13"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test --concurrency=4",
    "type-check": "turbo run type-check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:dev": "turbo run docs:dev --filter=@blendsdk/upload-docs",
    "docs:build": "turbo run docs:build --filter=@blendsdk/upload-docs",
    "docs:preview": "turbo run docs:preview --filter=@blendsdk/upload-docs",
    "pack:check": "node scripts/check-pack.mjs",
    "verify": "pnpm format:check && pnpm type-check && pnpm build && pnpm test && pnpm docs:build && pnpm pack:check",
    "lockstep": "lockstep",
    "lockstep:sync": "lockstep sync",
    "lockstep:version:auto": "lockstep version --type auto --ci --no-changelog --fail-on-no-changes",
    "lockstep:version:patch": "lockstep version --type patch --ci --no-changelog --fail-on-no-changes",
    "lockstep:version:minor": "lockstep version --type minor --ci --no-changelog --fail-on-no-changes",
    "lockstep:version:major": "lockstep version --type major --ci --no-changelog --fail-on-no-changes",
    "lockstep:changelog": "lockstep changelog",
    "publish:latest": "node scripts/publish.mjs latest --preflight",
    "publish:next": "node scripts/publish.mjs next --exact --preflight",
    "publish:beta": "node scripts/publish.mjs beta --exact --preflight"
  },
  "devDependencies": {
    "@blendsdk/lockstep": "^1.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/blendsdk/upload.git"
  }
}
