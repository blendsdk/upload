{
  "name": "@blendsdk/fluentui-upload",
  "version": "0.1.0",
  "description": "Fluent UI v9 upload component for React 19",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "clean": "rm -fR ./dist"
  },
  "dependencies": {
    "@blendsdk/upload-client": "^0.1.0",
    "@blendsdk/upload-core": "^0.1.0",
    "react-dropzone": "^20.1.4"
  },
  "peerDependencies": {
    "@fluentui/react-components": "^9.75.0",
    "@fluentui/react-icons": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/blendsdk/upload.git",
    "directory": "packages/fluentui-upload"
  },
  "devDependencies": {
    "@fluentui/react-components": "^9.75.0",
    "@fluentui/react-icons": "^2.0.344",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.10"
  }
}
