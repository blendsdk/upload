{
  "name": "@blendsdk/webafx-upload",
  "version": "0.1.0",
  "description": "WebAFX v5 upload session API, tus transport and finalization pipeline",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "clean": "rm -fR ./dist"
  },
  "dependencies": {
    "@blendsdk/upload-core": "^0.1.0",
    "@tus/file-store": "^2.1.1",
    "@tus/server": "^2.4.6",
    "file-type": "^22.2.0",
    "jose": "^6.2.5",
    "sharp": "^0.35.5"
  },
  "peerDependencies": {
    "blendsdk": ">=5.66.0 <6.0.0",
    "express": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "blendsdk": "^5.66.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "supertest": "^7.2.2",
    "tus-js-client": "^4.3.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/blendsdk/upload.git",
    "directory": "packages/webafx-upload"
  }
}
