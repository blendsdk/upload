{
  "name": "@blendsdk/upload-client",
  "version": "0.2.1",
  "description": "Framework-agnostic resumable upload manager and tus transport for BlendSDK upload",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "clean": "rm -fR ./dist"
  },
  "dependencies": {
    "@blendsdk/upload-core": "^0.2.1",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/blendsdk/upload.git",
    "directory": "packages/upload-client"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
