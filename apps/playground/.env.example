# Local WebAFX upload server
PORT=3001
UPLOAD_TOKEN_SECRET=playground-token-secret-change-before-sharing
LOG_LEVEL=INFO

# Set to 1 to finalize into S3Mock instead of local filesystem storage.
PLAYGROUND_S3=0
S3_ENDPOINT=http://127.0.0.1:9090
S3_BUCKET=uploads-test
S3_REGION=us-east-1
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
